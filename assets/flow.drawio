<mxfile host="app.diagrams.net" type="device">
  <diagram id="leaker-flow" name="Leaker flow">
    <mxGraphModel dx="1280" dy="760" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
